@model IEnumerable<Student_Portal.Models.CourseMaster>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CourseCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CourseName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DepartmentID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
           @*  <th>
                @Html.DisplayNameFor(model => model.DepartmentMaster)
            </th> *@
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.CourseCode)
            </td>
            <td>
                @Html.DisplayFor(model => item.CourseName)
            </td>
            <td>
                @Html.DisplayFor(model => item.DepartmentID)
            </td>
            <td>
                @Html.DisplayFor(model => item.Status)
            </td>
            @* <td>
                @Html.DisplayFor(model => item.DepartmentMaster)
            </td> *@
            <td>
                <a asp-action="Edit" asp-route-id="@item.courseID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.courseID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.courseID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
